{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["backend/scripts/dev-serve.sh"],
      "port": 8080
    },
    {
      "name": "web-app",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web/app && npm run dev -- -p 3000"],
      "port": 3000
    },
    {
      "name": "web-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web/frontend && npm run dev -- -p 3001"],
      "port": 3001
    },
    {
      "name": "web-admin",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web/admin && npm run dev -- -p 3002"],
      "port": 3002
    },
    {
      "name": "web-personas",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web/personas-open-source && npm run dev -- -p 3003"],
      "port": 3003
    }
  ]
}
